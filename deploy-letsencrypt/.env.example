# =============================================================================
# Exemple de configuration locale pour deploy-letsencrypt.sh et renew.sh.
#
# Copiez ce fichier en .env dans le meme repertoire, puis adaptez les valeurs.
# Le fichier .env est ignore par git : c'est la que doivent figurer toutes les
# donnees propres a votre installation.
#
#   cp .env.example .env
#
# ATTENTION : ne placez jamais de secret dans un fichier versionne. Les secrets
# du serveur ne se passent pas par ces variables mais par des fichiers montes
# dans le conteneur, avec des droits restreints :
#   - le secret TURN par -turn-secret-file (jamais -turn-secret, qui apparait
#     dans la liste des processus) ;
#   - le mot de passe d'administration par -admin-password-file, stocke sous
#     forme de condensat bcrypt ;
#   - la cle privee TLS reste dans le volume certbot, monte en lecture seule.
# =============================================================================

# Domaine principal du certificat.
DOMAIN=nvdaremote.example.com

# Domaine supplementaire couvert par le meme certificat.
ADDITIONAL_DOMAIN=remote.example.com

# Adresse de contact transmise a Let's Encrypt.
EMAIL=contact@example.com

# DocumentRoot du vhost servant le port 80, utilise pour le challenge HTTP-01.
#
# ATTENTION : ce chemin doit rester identique a celui enregistre par certbot
# lors de la premiere emission, visible dans
# /etc/letsencrypt/renewal/<domaine>.conf (cles webroot_path et webroot_map).
# S'il change, le renouvellement ne trouve plus le repertoire de defi.
WEBROOT=/var/www/html

# Nom et image du conteneur du serveur.
SERVER_NAME=nvdaremote
SERVER_IMAGE=nvdaremoteserver-docker

# Arguments de lancement du serveur, hors -cert-file et -key-file qui sont
# ajoutes automatiquement.
#
# Depuis le multiplexage, l'adresse -ws-address accepte a la fois le WebSocket
# et le protocole NVDA Remote historique. Ajoutez -ws-raw=false pour revenir au
# comportement WebSocket seul. Voir TCP-and-WebSocket.md.
#
# ATTENTION, PARTAGE D'ECRAN : le serveur ne relaie la signalisation WebRTC que
# si -screen-share figure ici, et il ne repond a la demande de justificatifs
# turn_credentials que si au moins un -turn-url est configure. Sans cela, les
# deux postes negocient la session mais le navigateur ouvre la connexion sans
# aucun serveur ICE : le lien n'aboutit jamais des que les deux postes ne sont
# pas sur le meme reseau, et le journal NVDA affiche
#   "Starting screen sharing without any ICE server"
#   "Screen sharing failed: The connection could not be established"
# Ces options doivent imperativement figurer dans SERVER_ARGS et non dans une
# ligne docker run tapee a la main : deploy-letsencrypt.sh recree le conteneur
# et perdrait tout argument absent d'ici.
#
# Exemple avec un STUN et un TURN (coturn) :
# SERVER_ARGS=-conf-read=false -ws-address :443 -screen-share -turn-url stun:nvdaremote.example.com:3478 -turn-url turns:nvdaremote.example.com:5349 -turn-secret-file /etc/nvdaremote/turn-secret -turn-ttl 3600
SERVER_ARGS=-conf-read=false -ws-address :443

# Chemin, sur l'hote, du fichier contenant le secret partage avec le serveur
# TURN. Il est monte en lecture seule dans le conteneur au meme chemin, ce qui
# permet de le designer tel quel par -turn-secret-file dans SERVER_ARGS.
# Laissez vide si le partage d'ecran n'utilise que des serveurs STUN.
# N'utilisez jamais -turn-secret, qui exposerait le secret dans la liste des
# processus.
TURN_SECRET_FILE=

# Ports publies, au format -p de docker run. Vous pouvez restreindre l'ecoute a
# une adresse IP precise, par exemple : -p 203.0.113.10:443:443
SERVER_PORTS=-p 443:443 -p 6837:6837

# Volumes Docker utilises par certbot.
VOL_ETC=le-etc
VOL_LIB=le-lib

# Volume Docker contenant le webroot du defi HTTP-01, a renseigner uniquement si
# le port 80 est servi par un conteneur (nginx par exemple) plutot que par un
# serveur web installe sur l'hote. Laissez vide pour monter directement le
# repertoire WEBROOT de l'hote.
VOL_WEB=

# Mettre a 1 pour un essai a blanc, sans consommer de quota Let's Encrypt.
STAGING=0
